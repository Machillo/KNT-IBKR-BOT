# IBKR connection
IBKR_HOST=127.0.0.1
# Paper: TWS=7497 / IB Gateway=4002
IBKR_PORT=4002
IBKR_CLIENT_ID=901
IBKR_ACCOUNT=
IBKR_READONLY=false
ALLOW_LIVE_TRADING=false

# Connection/reconnect
IBKR_CONNECTION_TIMEOUT=10
IBKR_RECONNECT_DELAY=5
IBKR_MAX_RECONNECT_ATTEMPTS=10

# Risk hard limits
MAX_TRADE_RISK_PCT=0.10
MAX_DAILY_LOSS_PCT=0.10
MAX_POSITION_PCT=0.10
KILL_SWITCH_ENABLED=true
# Keep true until the armed liquidation flow has been Paper-tested.
KILL_SWITCH_DRY_RUN=true

# 1=Live, 2=Frozen, 3=Delayed, 4=Delayed Frozen
MARKET_DATA_TYPE=3

# Autonomous runtime
SUPERVISOR_POLL_SECONDS=15
REQUIRE_FLAT_STARTUP=true
RUN_BROKER_SMOKE_TESTS=false
RUN_DISCOVERY_PROBE=false
DISCOVERY_ROWS=10
AUTONOMOUS_TRADING_ENABLED=false

# Multi-strategy Paper Alpha shadow mode (read-only strategy decisions)
SHADOW_TRADING_ENABLED=true
SHADOW_INTERVAL_SECONDS=900
